{
  "schemaVersion": 1,
  "id": "io.github.andrecards.voicefilters",
  "name": "Omarchy Voice Filters",
  "version": "1.0.0",
  "author": "Andre Cardoso",
  "license": "MIT",
  "homepage": "https://github.com/andrecards/omarchy-voice-filters",
  "description": "Virtual microphone with noise reduction, voice profiles, and gain controls. Based on MIT-licensed Omavoice.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Voice Filters",
    "description": "Virtual microphone with voice isolation and audio controls.",
    "category": "Audio",
    "aliases": [
      "voicefilters",
      "noise",
      "microphone",
      "voice"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "preset": "podcast",
      "pinnedSource": "",
      "previousAudioSource": "",
      "setDefaultSource": false,
      "engine": "auto",
      "meetingQuality": "better",
      "podcastQuality": "good",
      "meetingEq": "warm",
      "podcastEq": "neutral",
      "meetingEqBodyDb": 0,
      "meetingEqPresenceDb": 0,
      "meetingEqAirDb": 0,
      "podcastEqBodyDb": 0,
      "podcastEqPresenceDb": 0,
      "podcastEqAirDb": 0,
      "outputGainDb": 0,
      "captureGainDb": 0
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Voice filters enabled",
        "defaultValue": true
      },
      {
        "key": "preset",
        "type": "enum",
        "label": "Profile",
        "options": [
          "dictation",
          "meeting",
          "podcast",
          "clean"
        ],
        "defaultValue": "podcast"
      },
      {
        "key": "engine",
        "type": "enum",
        "label": "Noise reduction engine",
        "options": [
          "auto",
          "rnnoise",
          "deepfilter"
        ],
        "defaultValue": "auto"
      },
      {
        "key": "pinnedSource",
        "type": "string",
        "label": "Pinned microphone name",
        "description": "Leave empty for automatic selection: USB first, then the default microphone.",
        "defaultValue": ""
      },
      {
        "key": "previousAudioSource",
        "type": "string",
        "label": "Last physical microphone used",
        "description": "Used in automatic mode when the virtual microphone is already the system default.",
        "defaultValue": ""
      },
      {
        "key": "setDefaultSource",
        "type": "boolean",
        "label": "Set filtered microphone as the default input",
        "defaultValue": false
      },
      {
        "key": "meetingQuality",
        "type": "enum",
        "label": "Meeting strength: gentle, balanced, or strong",
        "options": [
          "good",
          "better",
          "best"
        ],
        "defaultValue": "better"
      },
      {
        "key": "podcastQuality",
        "type": "enum",
        "label": "Recording strength: gentle, balanced, or strong",
        "options": [
          "good",
          "better",
          "best"
        ],
        "defaultValue": "good"
      },
      {
        "key": "meetingEq",
        "type": "enum",
        "label": "Meeting voice tone",
        "options": [
          "neutral",
          "warm",
          "clear",
          "bright"
        ],
        "defaultValue": "warm"
      },
      {
        "key": "podcastEq",
        "type": "enum",
        "label": "Recording voice tone",
        "options": [
          "neutral",
          "warm",
          "clear",
          "bright"
        ],
        "defaultValue": "neutral"
      },
      {
        "key": "meetingEqBodyDb",
        "type": "number",
        "label": "Meeting body (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "meetingEqPresenceDb",
        "type": "number",
        "label": "Meeting presence (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "meetingEqAirDb",
        "type": "number",
        "label": "Meeting air (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqBodyDb",
        "type": "number",
        "label": "Recording body (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqPresenceDb",
        "type": "number",
        "label": "Recording presence (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqAirDb",
        "type": "number",
        "label": "Recording air (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "outputGainDb",
        "type": "number",
        "label": "Output gain (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "captureGainDb",
        "type": "number",
        "label": "Input gain (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      }
    ]
  },
  "repository": "https://github.com/andrecards/omarchy-voice-filters"
}
