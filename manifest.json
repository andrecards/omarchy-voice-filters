{
  "schemaVersion": 1,
  "id": "admin.voicefilters",
  "name": "Filtros de Voz Omarchy",
  "version": "0.1.0",
  "author": "admin (derivado de Omavoice por GigaSolo)",
  "license": "MIT",
  "homepage": "https://github.com/gigasolo/omavoice",
  "description": "Microfone virtual com isolamento de ruído, perfis de voz e controles de ganho em dB. Derivado do Omavoice, de licença MIT.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Filtros de Voz",
    "description": "Microfone virtual com redução de ruído e controles de voz.",
    "category": "Audio",
    "aliases": [
      "voicefilters",
      "noise",
      "microphone",
      "voice"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "preset": "podcast",
      "pinnedSource": "",
      "previousAudioSource": "",
      "setDefaultSource": true,
      "engine": "auto",
      "meetingQuality": "better",
      "podcastQuality": "good",
      "meetingEq": "warm",
      "podcastEq": "neutral",
      "meetingEqBodyDb": 0,
      "meetingEqPresenceDb": 0,
      "meetingEqAirDb": 0,
      "podcastEqBodyDb": 0,
      "podcastEqPresenceDb": 0,
      "podcastEqAirDb": 0,
      "outputGainDb": 0,
      "captureGainDb": 0
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Filtros de voz ativos",
        "defaultValue": true
      },
      {
        "key": "preset",
        "type": "enum",
        "label": "Perfil",
        "options": [
          "meeting",
          "podcast",
          "clean"
        ],
        "defaultValue": "podcast"
      },
      {
        "key": "engine",
        "type": "enum",
        "label": "Motor de redução de ruído",
        "options": [
          "auto",
          "rnnoise",
          "deepfilter"
        ],
        "defaultValue": "auto"
      },
      {
        "key": "pinnedSource",
        "type": "string",
        "label": "Nome do microfone fixado",
        "description": "Vazio ativa o modo automático: prioriza USB; caso contrário, usa o microfone padrão.",
        "defaultValue": ""
      },
      {
        "key": "previousAudioSource",
        "type": "string",
        "label": "Último microfone físico usado",
        "description": "Usado pelo modo automático quando a fonte padrão já é o microfone virtual.",
        "defaultValue": ""
      },
      {
        "key": "setDefaultSource",
        "type": "boolean",
        "label": "Definir o microfone filtrado como entrada padrão",
        "defaultValue": true
      },
      {
        "key": "meetingQuality",
        "type": "enum",
        "label": "Reunião: suave, equilibrado ou forte",
        "options": [
          "good",
          "better",
          "best"
        ],
        "defaultValue": "better"
      },
      {
        "key": "podcastQuality",
        "type": "enum",
        "label": "Gravação: suave, equilibrado ou forte",
        "options": [
          "good",
          "better",
          "best"
        ],
        "defaultValue": "good"
      },
      {
        "key": "meetingEq",
        "type": "enum",
        "label": "Timbre da voz em reunião",
        "options": [
          "neutral",
          "warm",
          "clear",
          "bright"
        ],
        "defaultValue": "warm"
      },
      {
        "key": "podcastEq",
        "type": "enum",
        "label": "Timbre da voz em gravação",
        "options": [
          "neutral",
          "warm",
          "clear",
          "bright"
        ],
        "defaultValue": "neutral"
      },
      {
        "key": "meetingEqBodyDb",
        "type": "number",
        "label": "Corpo em reunião (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "meetingEqPresenceDb",
        "type": "number",
        "label": "Presença em reunião (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "meetingEqAirDb",
        "type": "number",
        "label": "Brilho em reunião (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqBodyDb",
        "type": "number",
        "label": "Corpo em gravação (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqPresenceDb",
        "type": "number",
        "label": "Presença em gravação (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqAirDb",
        "type": "number",
        "label": "Brilho em gravação (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "outputGainDb",
        "type": "number",
        "label": "Ganho de saída (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "captureGainDb",
        "type": "number",
        "label": "Ganho de entrada (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      }
    ]
  }
}
